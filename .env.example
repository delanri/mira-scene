# 复制成 .env 再填。全部留空也能完整体验（演示模式 + 内置照片）

# ---------- 对话 ----------
# 填了就是在线模式（DeepSeek），不填自动进入演示模式
DEEPSEEK_API_KEY=
# 有 key 也想强制用演示模式时设为 true
FORCE_MOCK=false

# ---------- 生图（她拿相机给你看的照片）----------
# 不配置：显示内置的冰岛极光照片
# 自动选择顺序：COMFYUI_URL → ZHIPU_API_KEY → 内置照片；也可以用 IMAGE_PROVIDER=comfyui / zhipu / none 强制指定

# 方式一：本地 ComfyUI（工作流在 comfyui/mira_photo_api.json）
COMFYUI_URL=
# 你本地的模型文件名（ComfyUI/models/checkpoints/ 下面的文件）
COMFYUI_CHECKPOINT=
# 可选：覆盖工作流里的采样步数 / CFG（用 Turbo / Lightning 类模型时改小，比如 6 和 1.5）
COMFYUI_STEPS=
COMFYUI_CFG=

# 方式二：智谱 CogView-3-Flash（https://open.bigmodel.cn 申请 key）
ZHIPU_API_KEY=

# 生成超过这个秒数就算失败，退回内置照片
IMAGE_TIMEOUT_S=60
